NODE_ENV=development
PORT=4010
SERVICE_NAME=deliveroo-clone-notification-service
LOG_LEVEL=info
APP_VERSION=1.0.0

# RabbitMQ should run on the same Docker network as this service.
# Do not expose RabbitMQ publicly.
RABBITMQ_URL=amqp://deliveroo:change-me@rabbitmq:5672
RABBITMQ_EXCHANGE=deliveroo.events
RABBITMQ_QUEUE=notification.events
